# URL ฐานของเว็บ ใช้สร้าง absolute URL ของการ์ดแชร์และ sitemap
# บน Vercel ไม่ต้องตั้งค่านี้ ระบบจะใช้โดเมนที่ Vercel ให้มาโดยอัตโนมัติ
# ตั้งค่านี้เมื่อผูกโดเมนจริงแล้วเท่านั้น เช่น https://maisonraisara.com
NEXT_PUBLIC_SITE_URL=

# ── สถิติจริง (Supabase) — ไม่ตั้ง = ใช้เลขประมาณการ เว็บทำงานปกติ ──
# ขั้นตอนเต็ม: ops/supabase-setup.md
# service role key เป็นความลับฝั่ง server — ห้าม commit ห้ามขึ้นต้น NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
